# Cloudflare Pages environment variables for the enquiry form.
# Set these in the Pages dashboard under Settings > Environment variables.
# Never commit real values.

# From resend.com. The free tier covers 3,000 emails a month.
RESEND_API_KEY=

# Where enquiries are delivered.
ENQUIRY_TO=layanan@rumahmanusia.com

# Must be an address on a domain verified in Resend, otherwise sends are
# rejected. Verifying rumahmanusia.com there means adding DKIM records —
# take care not to disturb the existing mail DNS while doing it.
ENQUIRY_FROM=Rumah Manusia <website@rumahmanusia.com>
