{
  "name": "app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:app": "node dist/app/server/server.mjs",
    "sync:static": "node tools/sync-static.mjs",
    "fetch:content": "node tools/fetch-content.mjs",
    "prebuild": "npm run sync:static && npm run seo:files && npm run fetch:content",
