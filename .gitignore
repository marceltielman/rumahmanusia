# Build output
app/dist/
studio/dist/

# Dependencies — package-lock.json IS committed so Cloudflare builds are
# reproducible. (The repo's initial .gitignore excluded it; that would make
# every CI install resolve fresh versions.)
node_modules/
.wrangler/

# Sanity Studio local state
studio/.sanity/

# Regenerable Sanity seed, built from content/*.json
content/.seed.ndjson

# Local scratch — fetched copy of the Claude Design canvas source
.import/

# Environment
.env
.env.*
!.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# macOS
.DS_Store
