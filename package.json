{
  "name": "rumah-manusia",
  "version": "1.0.0",
  "private": true,
  "description": "Rumah Manusia — single-page site. Angular app in app/, Sanity Studio in studio/, content mirrored in content/.",
  "scripts": {
    "postinstall": "npm --prefix app install",
    "build": "npm --prefix app run build",
    "start": "npm --prefix app start",
    "test": "npm --prefix app test",
    "studio": "npm --prefix studio run dev",
    "studio:deploy": "npm --prefix studio run deploy",
    "content:fetch": "npm --prefix app run fetch:content",
    "content:seed": "node tools/make-sanity-import.mjs"
  }
}
