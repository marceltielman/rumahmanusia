{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rumahmanusia",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-27",

  // The prerendered site. Cloudflare serves a matching file before the Worker
  // runs, so the Worker only sees /api/enquiry and genuine misses.
  "assets": {
    "directory": "app/dist/app/browser",
    "binding": "ASSETS",
    // Not "single-page-application": that answers every unknown path with the
    // homepage and a 200, which reads as a soft 404 to search engines. The old
    // WordPress URLs should return a real 404 until redirects exist.
    "not_found_handling": "404-page",

    // Without this the asset layer answers navigation requests itself and
    // rejects a POST with 405 before the Worker runs — which broke the
    // no-JavaScript form submit while curl (not a navigation) worked fine.
    "run_worker_first": ["/api/*"]
  },

  "observability": { "enabled": true }
}
