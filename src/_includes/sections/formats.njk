<section class="rm-rise" id="experiences">
  <div class="rm-wrap">
    {{ m.eyebrow(sections.formats.eyebrow) }}
    <h2 class="rm-h2">{{ sections.formats.heading }}</h2>
    <div class="rm-tabrow" role="tablist" aria-label="Audiences" data-tabs="audience" style="margin:36px 0 0">
      {%- for a in audiences %}
      {{ m.tab("aud", loop.index0, a.name) }}
      {%- endfor %}
    </div>
    {%- for a in audiences %}
    <div class="rm-grid rm-tabpanel" role="tabpanel" id="rm-aud-{{ loop.index0 }}" aria-labelledby="rm-aud-tab-{{ loop.index0 }}" style="margin-top:32px"{% if not loop.first %} hidden{% endif %}>
      {%- for it in a.items %}
      <div class="rm-card rm-panelcard">
        <span class="tag tag-accent" style="margin-bottom:16px;display:inline-flex">{{ it.num }}</span>
        <h4 class="rm-cardtitle">{{ it.title }}</h4>
        <p class="rm-cardbody">{{ it.body }}</p>
      </div>
      {%- endfor %}
    </div>
    {%- endfor %}
    <div class="rm-grid" style="margin-top:16px">
      {%- for caption in sections.formats.slots %}
      <div class="grayscale" style="height:200px;border-radius:16px;overflow:hidden">{{ m.slot("rm-exp-" + loop.index, caption) }}</div>
      {%- endfor %}
    </div>
  </div>
</section>
