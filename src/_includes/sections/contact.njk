<section class="rm-rise" id="contact">
  <div class="rm-wrap" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:clamp(32px,4vw,56px);align-items:start">
    <div>
      {{ m.eyebrow(sections.contact.eyebrow) }}
      <h2 class="rm-h2" style="font-size:34px">{{ sections.contact.heading }}</h2>
      <div style="border-top:1px solid var(--color-divider);margin-top:28px">
        {%- for c in site.contacts %}
        <div class="rm-contactrow"><span>{{ c.label }}</span><span>{{ c.value }}</span></div>
        {%- endfor %}
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:28px;margin-top:32px">
        {%- for office in site.offices %}
        <div>
          {{ m.eyebrow(office.city, false, "margin-bottom:8px") }}
          <p style="margin:0;font-size:15px">{{ office.address | join("<br>") | safe }}</p>
        </div>
        {%- endfor %}
      </div>
    </div>
    <div style="background:var(--color-surface);border-radius:24px;padding:clamp(24px,3vw,36px)">
      <h4 style="margin:0 0 20px;font-weight:500">{{ sections.contact.formTitle }}</h4>
      <form id="rm-form" novalidate>
        {%- for f in sections.contact.fields %}
        <div class="field" style="margin-bottom:16px">
          <label for="rm-{{ f.name }}">{{ f.label }}</label>
          <input class="input" id="rm-{{ f.name }}" name="{{ f.name }}" type="{{ f.type }}"{% if f.placeholder %} placeholder="{{ f.placeholder }}"{% endif %}{% if f.required %} required{% endif %}>
        </div>
        {%- endfor %}
        <button type="submit" class="btn btn-primary btn-block">{{ site.cta }}</button>
        <p id="rm-form-note" role="status" data-email="{{ site.email }}" style="margin-top:14px;font-size:13px;color:var(--color-accent-700);min-height:20px"></p>
      </form>
    </div>
  </div>
</section>
