<section class="rm-rise">
  <div class="rm-wrap">
    {{ m.eyebrow(sections.vision.eyebrow) }}
    <h2 class="rm-h2" style="max-width:30ch">{{ sections.vision.heading }}</h2>
    <p class="rm-lead" style="margin-bottom:48px">{{ sections.vision.lead }}</p>
    {{ m.eyebrow(sections.vision.missionEyebrow) }}
    <div class="rm-grid">
      {%- for card in sections.vision.mission %}
      <div class="rm-card rm-panelcard">
        <h4 class="rm-cardtitle">{{ card.title }}</h4>
        <p class="rm-cardbody">{{ card.body }}</p>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>
